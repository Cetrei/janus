# Model source configuration for janus_biometrics.
#
# Each entry needs exactly one of `url` (downloaded and cached locally) or
# `local_path` (an operator-supplied file, read directly, no network
# access and no redistribution question). `sha256` is mandatory in both
# cases and is verified before the file is ever loaded (see models.py).
#
# NOTE: the sha256 values below are placeholders. They are intentionally
# NOT real hashes: janus_biometrics refuses to load a model whose hash
# does not match, so a placeholder simply fails closed on first use
# instead of silently trusting unverified weights. Replace each one with
# the real sha256 of the file you intend to use before enabling that
# provider.

models:
  scrfd:
    # Face detector, opt-in alternative to yunet for better tolerance to
    # head tilt/profile angles (local:scrfd variant, see
    # providers/sface.py's SFaceFaceVerifier docstring). From InsightFace's
    # antelopev2 pack (deepinsight/insightface), scrfd_10g_bnkps.onnx.
    #
    # LICENSE WARNING, read before enabling: unlike every other model in
    # this file, SCRFD's weights are "available for non-commercial research
    # purposes only" (InsightFace's own README), not MIT/Apache-2.0. Do
    # not enable local:scrfd without making your own licensing
    # determination for your use case -- see NOTICE and
    # docs/specs/spec-18-biometrics.md for how this project's own decision
    # was scoped (personal/portfolio use, not commercial, not
    # redistributed as a product).
    sha256: "TODO(confirm): sha256sum of scrfd_10g_bnkps.onnx"
    url: "https://huggingface.co/Aitrepreneur/insightface/resolve/main/models/antelopev2/scrfd_10g_bnkps.onnx"
    license: "Non-commercial research only (InsightFace) -- read NOTICE before enabling"

  yunet:
    # Face detector. opencv/opencv_zoo, MIT license.
    sha256: "TODO(confirm): sha256sum of face_detection_yunet_2023mar.onnx"
    url: "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx"
    license: "MIT"

  sface:
    # Face embedding (128-dim). opencv/opencv_zoo, Apache-2.0 license.
    sha256: "TODO(confirm): sha256sum of face_recognition_sface_2021dec.onnx"
    url: "https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx"
    license: "Apache-2.0"

  minifasnet:
    # Liveness / anti-spoofing (MiniFASNetV2 + V1SE combined), from the
    # Silent-Face-Anti-Spoofing project (minivision-ai). License confirmed
    # by reading the upstream repo's own LICENSE file: full, unmodified
    # Apache License 2.0 text, copyright 2020 Minivision, no per-file
    # exception for the model weights.
    # https://github.com/minivision-ai/Silent-Face-Anti-Spoofing/blob/master/LICENSE
    # sha256 is still a placeholder: no fixed upstream URL for the combined
    # ONNX weights, so `local_path` stays required (operator supplies their
    # own copy; replace with the real sha256sum of that file before use).
    sha256: "TODO(confirm): sha256sum of your local minifasnet onnx file"
    local_path: "/opt/janus/models/minifasnet_v2_v1se.onnx"
    license: "Apache-2.0"

  wespeaker:
    # Speaker verification (requisito 9), WeSpeaker ResNet34, 256-dim
    # embedding. Consumed via sherpa-onnx's SpeakerEmbeddingExtractor
    # (extra `voice`, see providers/speaker_wespeaker.py) -- this resolves
    # spec-18's fbank frontend Open Question (Architect decision
    # 2026-09-27; sherpa-onnx chosen over speakeronnx/kaldi-native-fbank,
    # see AGENT.md).
    #
    # Unlike minifasnet above, this DOES have a fixed, verifiable upstream
    # URL (sherpa-onnx's own release asset), so the real models.yaml uses
    # `url` + a real sha256 ("5ef208a9da1453335308a6b6f4e6dfbd7e183a38b604de0a57664f45d257fe94",
    # verified 2026-09-27 by downloading, sha256sum, AND loading it with
    # sherpa_onnx.SpeakerEmbeddingExtractor to confirm 256-dim output) --
    # copy that entry directly instead of the placeholder below if you
    # want the exact same file. This placeholder stays local_path-based
    # to keep this example's own "replace before use" pattern for anyone
    # supplying a different wespeaker variant (e.g. cnceleb/zh) instead.
    sha256: "TODO(confirm): sha256sum of your downloaded wespeaker resnet34 onnx file"
    local_path: "/opt/janus/models/wespeaker_en_voxceleb_resnet34.onnx"
    license: "CC BY 4.0 (VoxCeleb) -- requires attribution, see NOTICE"
